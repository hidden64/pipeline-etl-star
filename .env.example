# =============================================================================
#  Configuration — copier en `.env` et renseigner les valeurs réelles.
#  `.env` est ignoré par git : aucun secret ne doit jamais partir sur GitHub.
# =============================================================================

# --- Connexion PostgreSQL ----------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=mobilite
PGUSER=mobilite_etl
PGPASSWORD=
# Encodage client : indispensable sous Windows, sinon les accents des noms
# d'arrêts ("Villejean-Université") remontent cassés.
PGCLIENTENCODING=UTF8

# --- Chemins -----------------------------------------------------------------
REPERTOIRE_DONNEES_BRUTES=data/brut
REPERTOIRE_TRAVAIL=data/travail
REPERTOIRE_RAPPORTS=rapports

# --- Source 1 : GTFS statique (réseau STAR, Keolis Rennes) -------------------
# Référencé sur l'agrégateur national transport.data.gouv.fr, jeu
# « Réseau urbain STAR » (id 580defb1a3a7292dcfa9d33f).
URL_GTFS=https://eu.ftp.opendatasoft.com/star/gtfs/GTFS_STAR_BUS_METRO_EN_COURS.zip
# Version « à venir » : publiée uniquement lors d'un changement de service
# (rentrée, travaux). Renvoie 404 le reste du temps — c'est normal, et c'est
# justement elle qui fournit le cas de dédoublonnage inter-versions.
URL_GTFS_A_VENIR=https://eu.ftp.opendatasoft.com/star/gtfs/GTFS_STAR_BUS_METRO_A_VENIR.zip
# Flux temps réel (protobuf GTFS-RT) : retards observés, pour le mode quotidien.
URL_GTFS_RT_TRIP_UPDATE=https://proxy.transport.data.gouv.fr/resource/star-rennes-integration-gtfs-rt-trip-update
CODE_RESEAU=STAR

# --- Source 2 : météo horaire (Open-Meteo, aucune clé requise) ---------------
# Deux points d'entrée : l'archive est consolidée mais a ~5 jours de retard,
# la prévision couvre le passé récent et le futur. Le code arbitre entre les deux.
URL_METEO_ARCHIVE=https://archive-api.open-meteo.com/v1/archive
URL_METEO_PREVISION=https://api.open-meteo.com/v1/forecast
METEO_LATITUDE=48.1147
METEO_LONGITUDE=-1.6794
METEO_FUSEAU=Europe/Paris

# --- Périmètre du chargement -------------------------------------------------
# Période = FENÊTRE DE VALIDITÉ DU FEED GTFS (lue dans calendar.txt).
# Hors de cette fenêtre, aucun service n'est actif : le calendrier GTFS ne décrit
# que la période qu'il couvre. Toute date en dehors produirait zéro passage.
#   2026-09-04 -> 2026-10-12 = 39 jours de service, ~2,35 M passages théoriques.
PERIODE_DEBUT=2026-09-04
PERIODE_FIN=2026-10-12

# /!\ Horizon météo : Open-Meteo fournit l'observé jusqu'à J-5 et la prévision
#     jusqu'à J+16. Au-delà, aucun relevé n'existe : les faits concernés sont
#     rattachés au membre inconnu de dim_meteo (sk_meteo = -1) et le rapport de
#     qualité le signale. Les exécutions quotidiennes successives comblent le
#     trou au fur et à mesure.

# Vide = toutes les lignes. Sinon, liste de route_short_name séparés par virgule.
# a/b = métro, C1..C7 = lignes Chronostar (structurantes).
LIGNES_RETENUES=a,b,C1,C2,C3,C4,C5,C6,C7

# --- Comportement du pipeline ------------------------------------------------
# Nombre de lignes par lot d'insertion.
TAILLE_LOT=10000
# Au-delà de ce taux de rejet (en %), le pipeline s'arrête en échec plutôt que
# de charger un entrepôt dont on sait déjà qu'il est faux.
SEUIL_ALERTE_REJET_PCT=5.0
